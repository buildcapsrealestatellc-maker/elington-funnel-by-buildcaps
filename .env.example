# Copy to .env.local and fill in. Nothing here is required for local dev:
# without sinks, leads are written to .data/leads.jsonl in development.

# ─── Site ───
# The public URL. Required in production: email links and images point here.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─── Email (Resend) ───
# Every form fill emails the brochure to the lead and a lead alert to the team.
# Verify your sending domain in Resend, then set EMAIL_FROM on that domain.
# Without a verified domain, Resend's test sender only delivers to the email
# address that owns the Resend account.
RESEND_API_KEY=
EMAIL_FROM="Berkeley Tower <brochure@yourdomain.com>"
# Where lead alerts go (comma-separated). Defaults to buildcapsrealestatellc@gmail.com.
LEAD_NOTIFY_TO=

# ─── Supabase: the shared Buildcaps database (every funnel in one project) ───
# Leads land in public.leads tagged with FUNNEL_SLUG (must exist in public.funnels).
# Schema: supabase/migrations/. The secret key stays server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FUNNEL_SLUG=berkeley-tower
# Random string; IPs are stored only as a salted hash.
LEAD_IP_SALT=
# Local only, for running migrations with psql. Never set on Vercel.
SUPABASE_DB_URL=

# ─── Lead delivery (at least one sink is required in production) ───
# The Resend lead alert above counts; a CRM / automation webhook can run alongside it
# (HubSpot, Salesforce, Zapier, Make, n8n).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ─── Bot protection (Cloudflare Turnstile) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Compliance (shown in the footer once issued) ───
NEXT_PUBLIC_TRAKHEESI_PERMIT=
NEXT_PUBLIC_RERA_PROJECT_NO=
NEXT_PUBLIC_ESCROW_ACCOUNT=

# ─── Brokerage (footer "Presented by" block, phone and WhatsApp CTAs) ───
# Defaults are Buildcaps Real Estate; set these to re-use the funnel for another agent.
NEXT_PUBLIC_BROKER_NAME=
NEXT_PUBLIC_BROKER_PHONE=
# Digits only, with the country code, e.g. 971582609991
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BROKER_EMAIL=
NEXT_PUBLIC_BROKER_ADDRESS=
NEXT_PUBLIC_BROKER_ORN=

# ─── Brochure ───
# The PDF the lead form unlocks. Defaults to public/brochure/berkeley-tower-brochure.pdf;
# point it at a CDN copy to keep the 22 MB file off the app server.
NEXT_PUBLIC_BROCHURE_URL=

# ─── Berkeley Concierge (AI chat) ───
# Without a key the Concierge still answers, from the project brief only.
ANTHROPIC_API_KEY=

# ─── Later phases ───
GOOGLE_MAPS_API_KEY=
FAL_KEY=

# ─── Google Search Console (HTML-tag verification code only, not the whole tag) ───
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
